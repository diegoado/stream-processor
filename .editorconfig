root = true

[*]
indent_style = space
indent_size = 2
max_line_length = 100
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[Makefile]
indent_style = tab

[*.go]
indent_size = 4
indent_style = tab
max_line_length = 120

[*.{yml,yaml}]
max_line_length = 120
